{
  "name": "oceanharness-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node scripts/serve-out.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node node_modules/next/dist/bin/next build && node --test tests/*.test.mjs",
    "update:downloads": "node scripts/update-downloads.mjs",
    "import:legacy-copy": "node scripts/import-legacy-copy.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
